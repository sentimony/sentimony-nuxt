{
  "name": "sentimony-nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "sh scripts/clean.sh",
    "setup": "sh scripts/setup.sh",
    "skills": "sh scripts/skills.sh",
    "preinstall": "npm run setup",
    "postinstall": "npm run skills",
    "dev": "TMPDIR=/tmp node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local node_modules/.bin/nuxt dev",
    "build": "TMPDIR=/tmp node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local node_modules/.bin/nuxt build",
    "build:cf": "NITRO_PRESET=cloudflare_module npm run build",
    "generate": "TMPDIR=/tmp node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local node_modules/.bin/nuxt generate",
    "preview": "TMPDIR=/tmp node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local node_modules/.bin/nuxt preview",
    "sync:firebase": "npm run convert:yml && node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/sync-firebase.mjs",
    "sync:supabase": "npm run convert:yml && node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/sync-supabase.mjs",
    "sync:field": "node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/sync-field.mjs",
    "convert:yml": "node scripts/convert-yml-json.mjs",
    "sync:track-audio": "node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/sync-track-audio.mjs",
    "typecheck": "TMPDIR=/tmp node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local node_modules/.bin/nuxt typecheck",
    "typecheck:ts7": "node node_modules/@typescript/native/bin/tsc -p netlify/tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:unit": "vitest run",
    "docs:check": "node scripts/docs-check.mjs",
    "perf:baseline": "node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/perf-baseline.mjs",
    "perf:lighthouse": "node --env-file-if-exists=.env/.env --env-file-if-exists=.env/.env.local scripts/lighthouse-baseline.mjs",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "web-debug": "node scripts/web-debug.mjs",
    "deploy:stage": "npm run netlify:stage",
    "deploy:prod": "npm run netlify:prod",
    "deploy:cf:stage": "npm run build:cf && npx -y wrangler@4 versions upload",
    "deploy:cf:prod": "npm run build:cf && npx -y wrangler@4 deploy",
    "netlify:stage": "npx -y dotenv-cli@11 -e .env/.env.local -e .env/.env -- npx -y netlify-cli@26 deploy --alias stage --context deploy-preview",
    "netlify:prod": "npx -y dotenv-cli@11 -e .env/.env.local -e .env/.env -- npx -y netlify-cli@26 deploy --prod --context production"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/lucide-lab": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.93",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@nuxt/icon": "^2.5.0",
    "@nuxtjs/google-fonts": "^3.2.0",
    "@nuxtjs/robots": "^6.1.4",
    "@nuxtjs/sitemap": "^8.3.4",
    "@nuxtjs/supabase": "^2.0.10",
    "@supabase/supabase-js": "^2.112.3",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "flag-icons": "^7.5.0",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.3",
    "swiper": "^14.1.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "v-wave": "^3.1.1",
    "vee-validate": "^4.15.1",
    "vue-sonner": "^2.0.9"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.0"
  }
}
