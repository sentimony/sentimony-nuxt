# Local dev env. Copy to .env/.env (gitignored) and fill in real values.
# Personal overrides go to .env/.env.local (also gitignored).

# Supabase Dashboard → Project Settings → API
# Canonical Nuxt names (NUXT_PUBLIC_SUPABASE_URL / NUXT_PUBLIC_SUPABASE_KEY) also work.
SUPABASE_URL=<SUBSTITUTE_SUPABASE_URL>
SUPABASE_KEY=<SUBSTITUTE_SUPABASE_PUBLISHABLE_KEY>
# Server-side only, NEVER expose to client bundle
SUPABASE_SECRET_KEY=<SUBSTITUTE_SUPABASE_SECRET_KEY>

# Catalog content source: firebase or supabase.
# Use NUXT_CATALOG_SOURCE for runtime overrides in deployed Nuxt/Nitro environments.
CATALOG_SOURCE=firebase

# GitHub Personal Access Token for Claude Code CLI (local use only).
# Generate at https://github.com/settings/tokens - scopes: repo, read:org.
# Belongs in .env.local (personal), not .env (team default).
PAT_FOR_CLAUDE_CODE=<GITHUB_PERSONAL_ACCESS_TOKEN>

# Netlify Personal Access Token of the account that owns the sentimony-nuxt site.
# Generate at https://app.netlify.com/user/applications#personal-access-tokens
# Belongs in .env.local (personal). Makes deploy:stage/deploy:prod independent
# of the active `netlify switch` account.
NETLIFY_AUTH_TOKEN=<NETLIFY_PERSONAL_ACCESS_TOKEN>

# Firebase Realtime Database secret for sync:firebase script.
# Firebase Console → Project Settings → Service Accounts → Database secrets.
# Belongs in .env.local (personal).
FIREBASE_DB_SECRET=<FIREBASE_DATABASE_SECRET>

# Cloudflare migration (docs/superpowers/plans/2026-07-26-cloudflare-migration.md).
# Account ID: Cloudflare Dashboard → any zone → Overview, right sidebar (32 hex chars).
# API token: Dashboard → My Profile → API Tokens → Create Token → Custom token.
# Required permissions: Zone:DNS:Edit, Zone:Cache Purge, Zone:Zone Settings:Edit,
# Zone:Cache Rules:Edit, Zone:Firewall Services:Edit, Account:Workers Scripts:Edit,
# Account:Workers KV Storage:Edit, Account:Account Settings:Read.
# Both belong in .env.local (personal).
# Account API tokens are NOT verifiable via /user/tokens/verify - it answers
# "Invalid API Token" even for a valid one. Use the account-scoped endpoint:
#   curl -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
#     "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/tokens/verify"
CLOUDFLARE_ACCOUNT_ID=<32_HEX_CHARS_e_g_0123456789abcdef0123456789abcdef>
CLOUDFLARE_API_TOKEN=<40_CHAR_TOKEN_e_g_AbCdEf1234567890-_AbCdEf1234567890abcd>

# Cloudflare R2 credentials for the sentimony-audio bucket (S3-compatible API).
# Dashboard → R2 → Manage R2 API Tokens → Create API token (Object Read & Write).
# Used for manual bucket maintenance (listing, renaming, deleting audio objects).
# Belongs in .env.local (personal).
R2_ACCOUNT_ID=<SAME_AS_CLOUDFLARE_ACCOUNT_ID>
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=sentimony-audio
R2_ACCESS_KEY_ID=<32_HEX_CHARS>
R2_SECRET_ACCESS_KEY=<64_HEX_CHARS>

# Optional: Google PageSpeed Insights API key for the perf baseline collector.
# https://console.cloud.google.com → APIs & Services → Credentials → API key.
# Without it the network measurements still run, only lab metrics are skipped.
PSI_API_KEY=<GOOGLE_API_KEY_e_g_AIzaSy...>
